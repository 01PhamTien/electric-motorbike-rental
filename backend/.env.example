PORT=3000
FRONTEND_URL=http://localhost:5173
# Local development only. In production JWT_SECRET must be a unique random key of at least 32 characters.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USERNAME=emr
DB_PASSWORD=emr123456
DB_DATABASE=electric_motorbike_rental
BOOKING_HOLD_MINUTES=15
TZ=Asia/Ho_Chi_Minh

# In production, provide DB_* secrets and manage schema with migrations.
# Never enable schema sync on production.
DB_SYNCHRONIZE=true
BOOKING_EXPIRY_ENABLED=true
BOOKING_EXPIRY_INTERVAL_MS=60000

# Swagger docs are disabled in production by default.
# ENABLE_SWAGGER=false
# Never run npm run seed in production. Demo account credentials are for local tests only.
