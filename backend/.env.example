PORT=3000
FRONTEND_URL=http://localhost:5173
# Local development only. Use a unique random secret (>=32 chars) outside local tests.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d

# SQL Server Express / Developer / Standard
DB_TYPE=mssql
DB_HOST=127.0.0.1
# Use the TCP port configured for your SQL Server instance (often 1433).
DB_PORT=1433
DB_USERNAME=voltgo_app
DB_PASSWORD=replace-with-a-strong-password
DB_DATABASE=VoltGoDB
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

BOOKING_HOLD_MINUTES=15
TZ=Asia/Ho_Chi_Minh
# TypeORM schema synchronization is intentionally disabled. Apply migrations explicitly.
DB_SYNCHRONIZE=false
BOOKING_EXPIRY_ENABLED=true
BOOKING_EXPIRY_INTERVAL_MS=60000

# Swagger docs are disabled in production by default.
# ENABLE_SWAGGER=false
# Never run npm run seed in production. Demo account credentials are for local tests only.
