# Local Windows SQL Server Express - VoltGoDB
# Copy this file to backend/.env (NEVER commit .env or send passwords).
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-your-own-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d

DB_TYPE=mssql
DB_HOST=127.0.0.1
DB_PORT=14333
DB_USERNAME=voltgo_app
DB_PASSWORD=replace-with-your-own-sql-server-password
DB_DATABASE=VoltGoDB
DB_SYNCHRONIZE=false

# Local development only. Do not trust invalid TLS certificates in production.
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

BOOKING_HOLD_MINUTES=15
BOOKING_EXPIRY_ENABLED=true
BOOKING_EXPIRY_INTERVAL_MS=60000
TZ=Asia/Ho_Chi_Minh
